{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/kirbornu/GimpanumMod/fields.schema.json",
  "title": "Наборы арканных полей рунной магии Гимпанума (fields.json)",
  "description": "Подсказки и проверка в редакторе. Что арканы и предметы существуют, проверяет мод при /gimpanum magic reload. Описание — docs/magic-config.md.",
  "type": "object",
  "required": [
    "sets"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Путь к этой схеме — для редактора; мод это поле пропускает."
    },
    "sets": {
      "type": "object",
      "required": [
        "default"
      ],
      "description": "Именованные наборы полей.",
      "properties": {
        "default": {
          "type": "object",
          "required": [
            "fields"
          ],
          "additionalProperties": false,
          "properties": {
            "catalysts": {
              "type": "array",
              "description": "Id предметов во второй руке, выбирающих этот набор. Один предмет — не больше чем в одном наборе.",
              "items": {
                "type": "string",
                "pattern": "^([a-z0-9_.-]+:)?[a-z0-9_./-]+$",
                "examples": [
                  "gimpanum:crystal_shard",
                  "minecraft:sculk"
                ]
              }
            },
            "turnAngle": {
              "type": "number",
              "description": "Свой угол поворота черепахи, градусы. Без него — из magic.json."
            },
            "stepMultiplier": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000,
              "description": "Свой множитель шага. Без него — из magic.json."
            },
            "fields": {
              "type": "array",
              "description": "Поля набора; порядок значим (ничьи — в пользу раннего).",
              "items": {
                "type": "object",
                "required": [
                  "arcane",
                  "center",
                  "radius"
                ],
                "additionalProperties": false,
                "properties": {
                  "arcane": {
                    "type": "string",
                    "pattern": "^[a-z0-9_]{1,64}$",
                    "description": "Id аркана из arcanes.json."
                  },
                  "center": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 3,
                    "maxItems": 3,
                    "description": "Центр [x, y, z] в пространстве рун."
                  },
                  "radius": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 1000000.0,
                    "description": "Радиус, больше нуля."
                  }
                }
              },
              "minItems": 1
            }
          },
          "description": "Набор без катализатора. Обязателен и не может быть пустым."
        }
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "fields"
        ],
        "additionalProperties": false,
        "properties": {
          "catalysts": {
            "type": "array",
            "description": "Id предметов во второй руке, выбирающих этот набор. Один предмет — не больше чем в одном наборе.",
            "items": {
              "type": "string",
              "pattern": "^([a-z0-9_.-]+:)?[a-z0-9_./-]+$",
              "examples": [
                "gimpanum:crystal_shard",
                "minecraft:sculk"
              ]
            }
          },
          "turnAngle": {
            "type": "number",
            "description": "Свой угол поворота черепахи, градусы. Без него — из magic.json."
          },
          "stepMultiplier": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000,
            "description": "Свой множитель шага. Без него — из magic.json."
          },
          "fields": {
            "type": "array",
            "description": "Поля набора; порядок значим (ничьи — в пользу раннего).",
            "items": {
              "type": "object",
              "required": [
                "arcane",
                "center",
                "radius"
              ],
              "additionalProperties": false,
              "properties": {
                "arcane": {
                  "type": "string",
                  "pattern": "^[a-z0-9_]{1,64}$",
                  "description": "Id аркана из arcanes.json."
                },
                "center": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3,
                  "description": "Центр [x, y, z] в пространстве рун."
                },
                "radius": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1000000.0,
                  "description": "Радиус, больше нуля."
                }
              }
            }
          }
        },
        "description": "Набор, выбираемый катализатором."
      }
    }
  }
}
