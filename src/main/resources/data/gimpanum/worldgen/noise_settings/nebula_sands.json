{
    "_comment": "Мироген Гимпанума. Высота всего 64 блока: пустыня сверху, лабиринт пещёр под ней. Плотность собрана по образцу ванильного Нижнего мира — та же связка squeeze/interpolated/blend_density и тот же base_3d_noise, потому что именно он даёт просторные пещеры-лабиринты. Приём с add(A, mul(градиент, add(-A, X))) — это линейная растяжка от A к X: так Нижний мир делает себе сплошной пол и потолок.",
    "aquifers_enabled": false,
    "ore_veins_enabled": false,
    "disable_mob_generation": true,
    "legacy_random_source": false,
    "sea_level": 0,
    "spawn_target": [],
    "default_block": {
        "Name": "gimpanum:cosmic_sand"
    },
    "default_fluid": {
        "Name": "minecraft:air"
    },
    "noise": {
        "min_y": 0,
        "height": 128,
        "size_horizontal": 1,
        "size_vertical": 2
    },
    "surface_rule": {
        "type": "minecraft:sequence",
        "sequence": [
            {
                "type": "minecraft:condition",
                "if_true": {
                    "type": "minecraft:vertical_gradient",
                    "random_name": "gimpanum:bedrock_floor",
                    "true_at_and_below": {
                        "above_bottom": 0
                    },
                    "false_at_and_above": {
                        "above_bottom": 5
                    }
                },
                "then_run": {
                    "type": "minecraft:block",
                    "result_state": {
                        "Name": "minecraft:bedrock"
                    }
                }
            },
            {
                "type": "minecraft:condition",
                "if_true": {
                    "type": "minecraft:vertical_gradient",
                    "random_name": "gimpanum:ash_layer",
                    "true_at_and_below": {
                        "above_bottom": 5
                    },
                    "false_at_and_above": {
                        "above_bottom": 9
                    }
                },
                "then_run": {
                    "type": "minecraft:block",
                    "result_state": {
                        "Name": "gimpanum:cosmic_ash"
                    }
                }
            },
            {
                "type": "minecraft:block",
                "result_state": {
                    "Name": "gimpanum:cosmic_sand"
                }
            }
        ]
    },
    "noise_router": {
        "barrier": 0.0,
        "continents": 0.0,
        "depth": 0.0,
        "erosion": 0.0,
        "fluid_level_floodedness": 0.0,
        "fluid_level_spread": 0.0,
        "lava": 0.0,
        "ridges": 0.0,
        "temperature": 0.0,
        "vegetation": 0.0,
        "vein_gap": 0.0,
        "vein_ridged": 0.0,
        "vein_toggle": 0.0,
