            "type": "minecraft:add",
            "argument1": {
                "type": "minecraft:y_clamped_gradient",
                "from_y": 70,
                "from_value": 1.0,
                "to_y": 100,
                "to_value": -1.0
            },
            "argument2": {
                "type": "minecraft:clamp",
                "input": {
                    "type": "minecraft:mul",
                    "argument1": 0.8,
                    "argument2": {
                        "type": "minecraft:noise",
                        "noise": "minecraft:surface",
                        "xz_scale": 1.0,
                        "y_scale": 0.0
                    }
                },
                "min": -0.85,
                "max": 0.85
            }
        },
        "final_density": {
            "type": "minecraft:squeeze",
            "argument": {
                "type": "minecraft:mul",
