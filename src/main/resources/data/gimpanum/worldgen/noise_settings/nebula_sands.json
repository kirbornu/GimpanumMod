                                    "argument1": {
                                        "type": "minecraft:y_clamped_gradient",
                                        "from_y": 56,
                                        "from_value": 1.0,
                                        "to_y": 64,
                                        "to_value": 0.0
                                    },
                                    "argument2": {
                                        "type": "minecraft:add",
                                        "argument1": -2.5,
                                        "argument2": {
                                            "type": "minecraft:add",
                                            "argument1": 2.5,
                                            "argument2": {
                                                "type": "minecraft:mul",
                                                "argument1": {
                                                    "type": "minecraft:y_clamped_gradient",
                                                    "from_y": 2,
