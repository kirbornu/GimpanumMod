                                },
                                "argument2": {
                                    "type": "minecraft:clamp",
                                    "input": {
                                        "type": "minecraft:mul",
                                        "argument1": 0.8,
                                        "argument2": {
                                            "type": "minecraft:noise",
                                            "noise": "minecraft:surface",
                                            "xz_scale": 1.0,
